#!/usr/bin/env bash
[[ $DOTFILES_DEBUG == "true" ]] && echo "[DOTFILE_DBG: Executing LOCAL_ADDITIONS]"

# Installers (claude, codex, cursor-agent, nvm, conda, rustup, pnpm, ...)
# append PATH/init lines to the end of ~/.bashrc or ~/.bash_profile. Both files
# are overwritten by bootstrap.sh / dotfiles_update, so at every shell start
# anything found below their local-additions marker is MOVED into
# ~/.systemspecific (never touched by bootstrap, sourced early in every load
# path) and removed from the rc file. This runs before ~/.systemspecific is
# sourced, so moved lines take effect in the very same shell.
#
# A legacy ~/.path file is absorbed into ~/.systemspecific the same way and
# then deleted (its role, early machine-specific PATH, moved there).
#
# - Paragraphs (blank-line separated blocks) that already exist verbatim in
#   the target are not appended again, so re-running installers is harmless.
# - Concurrent shell starts are serialized with flock (when available).
# - Legacy rc files without the marker are handled too: ~/.bashrc after its
#   `source ~/.bash_profile` line, ~/.bash_profile after its closing
#   `fi # end ... check` line.
#
# Knob: DOTFILES_LOCAL_ADDITIONS_FILE (default ~/.systemspecific).

DOTFILES_LOCAL_ADDITIONS_MARKER='# >>> dotfiles: local additions below this line survive bootstrap/update >>>'

# Reads $1 into __dla_lines and sets __dla_anchor to the index of the marker
# (or legacy anchor) line. Returns 1 when there is no anchor.
function __dotfiles_local_additions_anchor {
	local file="$1" i n
	__dla_anchor=-1
	mapfile -t __dla_lines < "$file" 2> /dev/null || return 1
	n=${#__dla_lines[@]}

	for (( i = 0; i < n; i++ )); do
		if [ "${__dla_lines[i]}" = "$DOTFILES_LOCAL_ADDITIONS_MARKER" ]; then
			__dla_anchor=$i
			return 0
		fi
	done

	case "${file##*/}" in
		.bashrc)
			for (( i = 0; i < n; i++ )); do
				case "${__dla_lines[i]}" in
					*'source ~/.bash_profile'*) __dla_anchor=$i; break ;;
				esac
			done
			;;
		.bash_profile)
			for (( i = 0; i < n; i++ )); do
				case "${__dla_lines[i]}" in
					'fi # end '*check) __dla_anchor=$i ;;
				esac
			done
			;;
	esac

	[ "$__dla_anchor" -ge 0 ]
}

# True when $1 has non-blank content below its anchor.
function __dotfiles_local_additions_has_tail {
	local i
	__dotfiles_local_additions_anchor "$1" || return 1
	for (( i = __dla_anchor + 1; i < ${#__dla_lines[@]}; i++ )); do
		[ -n "${__dla_lines[i]//[[:space:]]/}" ] && return 0
	done
	return 1
}

# Append the paragraphs of __dla_lines after __dla_anchor to $2 unless they
# already exist there verbatim. $1 is the source name used in the header.
# Sets __dla_moved=1 when something was appended.
function __dotfiles_local_additions_append_paragraphs {
	local source_name="$1" target="$2"
	local i n line paragraph='' target_content='' header_written=0

	__dla_moved=0
	n=${#__dla_lines[@]}
	[ -f "$target" ] && target_content="$(< "$target")"

	for (( i = __dla_anchor + 1; i <= n; i++ )); do
		line=''
		(( i < n )) && line="${__dla_lines[i]}"
		if [ -n "${line//[[:space:]]/}" ]; then
			paragraph+="${paragraph:+$'\n'}$line"
			continue
		fi
		[ -n "$paragraph" ] || continue

		if [[ "$target_content" != *"$paragraph"* ]]; then
			if (( header_written == 0 )); then
				printf '\n# --- moved from %s by dotfiles on %s ---\n' "${source_name/#$HOME/\~}" "$(date '+%Y-%m-%d %H:%M:%S')" >> "$target" || return 1
				header_written=1
			fi
			printf '%s\n' "$paragraph" >> "$target" || return 1
			target_content+=$'\n'"$paragraph"
			__dla_moved=1
		fi
		paragraph=''
	done
	return 0
}

# Move the tail of rc file $1 into $2, then truncate $1 back to its anchor.
function __dotfiles_local_additions_move_locked {
	local file="$1" target="$2"

	__dotfiles_local_additions_has_tail "$file" || return 0
	__dotfiles_local_additions_append_paragraphs "$file" "$target" || return 0
	# In place: same inode and mode.
	printf '%s\n' "${__dla_lines[@]:0:__dla_anchor + 1}" > "$file"
	dotfiles_dbg "Local additions: moved tail of ${file/#$HOME/\~} to ${target/#$HOME/\~} (new content appended: $__dla_moved)"
}

# Move the whole content of $1 into $2 and delete $1.
function __dotfiles_local_additions_absorb_locked {
	local file="$1" target="$2"

	mapfile -t __dla_lines < "$file" 2> /dev/null || return 0
	__dla_anchor=-1
	__dotfiles_local_additions_append_paragraphs "$file" "$target" || return 0
	rm -f "$file"
	dotfiles_dbg "Local additions: absorbed ${file/#$HOME/\~} into ${target/#$HOME/\~} (new content appended: $__dla_moved)"
}

# __dotfiles_local_additions_with_lock <callback> <file> <target>
function __dotfiles_local_additions_with_lock {
	local callback="$1" file="$2" target="$3" lock_fd='' target_existed=1

	# Decide before the lock fd creates the file: a target we create ourselves
	# gets mode 600 (installer lines may carry tokens).
	[ -e "$target" ] || target_existed=0

	if command -v flock > /dev/null 2>&1; then
		exec {lock_fd}>> "$target" || return 0
		if ! flock -w 5 "$lock_fd"; then
			exec {lock_fd}>&-
			return 0
		fi
	fi
	"$callback" "$file" "$target"
	[ -n "$lock_fd" ] && exec {lock_fd}>&-
	if (( target_existed == 0 )) && [ -f "$target" ]; then
		chmod 600 "$target" 2> /dev/null
	fi
	return 0
}

function dotfiles_migrate_local_additions {
	local target="${DOTFILES_LOCAL_ADDITIONS_FILE:-$HOME/.systemspecific}"
	local file

	for file in "$HOME/.bashrc" "$HOME/.bash_profile"; do
		[ -f "$file" ] && [ -r "$file" ] && [ -w "$file" ] || continue
		__dotfiles_local_additions_has_tail "$file" || continue
		__dotfiles_local_additions_with_lock __dotfiles_local_additions_move_locked "$file" "$target"
	done

	if [ -f "$HOME/.path" ] && [ -r "$HOME/.path" ] && [ -w "$HOME/.path" ]; then
		__dotfiles_local_additions_with_lock __dotfiles_local_additions_absorb_locked "$HOME/.path" "$target"
	fi

	unset __dla_lines __dla_anchor __dla_moved
}
