# Local dotfiles feature overrides: copy to ~/.config/dotfiles/features.local
# (i.e. $DOTFILES_LOCAL_HOME/features.local; per-user, survives updates and
# applies on top of a shared system-wide install too).
# Uncomment one profile line (minimal is the installation default):
# DOTFILES_FEATURE_PROFILE=full
# DOTFILES_FEATURE_PROFILE=light
DOTFILES_FEATURE_PROFILE=minimal

# Command auditing (on in every profile; set to false to opt this user out):
# DOTFILES_FEATURE_HISTORY_AUDIT=true

# Command duration start hook method:
# DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD=auto
# DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD=ps0
# DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD=debug

# Dotfiles update checks:
# DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK=false
# DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE=interactive
# DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE=ssh
# DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS=43200
