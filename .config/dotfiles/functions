#!/usr/bin/env bash
[[ $DOTFILES_DEBUG == "true" ]] && echo "[DOTFILE_DBG: Executing FUNCTIONS]"

if ! declare -F dotfiles_dbg > /dev/null; then
	function dotfiles_dbg {
		[[ "$DOTFILES_DEBUG" == "true" ]] && printf '[DOTFILE_DBG: %s]\n' "$*"
	}
fi

_dotfiles_functions_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for functions_file in \
	"${_dotfiles_functions_dir}/functions.internal.bash" \
	"${_dotfiles_functions_dir}/functions.external.bash"; do
	if [ -r "$functions_file" ] && [ -f "$functions_file" ]; then
		source "$functions_file"
	else
		dotfiles_dbg ".FUNCTIONS skipping missing file: $functions_file"
	fi
done

unset functions_file _dotfiles_functions_dir
