#!/usr/bin/env bash
[[ $DOTFILES_DEBUG == "true" ]] && echo "[DOTFILE_DBG: Executing .DOTFILES_AGENT_AUDIT]"

# Lightweight command audit for agent-mode shells (sourced by the runtime
# bash_profile only when the agent guard is active). Records go to a separate
# agent log next to the regular audit log: <identity>.agent.log in the shared
# store (default /var/log/dotfiles/audit) on system-scope installs, otherwise
# the legacy ~/.bash_history_audit_agent:
#
#   timestamp  user  agent  exit:N  took:D  command
#
# How commands are captured:
# - Non-interactive `bash -c` shells (Codex CLI: `bash -lc "<cmd>"`, cron, ...):
#   one record per invocation with the complete command string
#   ($BASH_EXECUTION_STRING), written from an EXIT trap with the final exit
#   code and wall-clock duration. No DEBUG trap is installed.
# - Interactive agent shells (Cursor / Cline / VS Code agent terminals, aider):
#   one record per prompt via PROMPT_COMMAND, exit code included, no duration.
# - Claude Code runs `bash -c` shells that read no rc file at all, only its
#   snapshot; the only Claude shell reaching this file is the snapshot
#   generator, which is skipped. Use init/claude-code-audit-hook.sh
#   (a PostToolUse hook) to feed the same file.
# - Non-interactive shells fed from stdin/a script file are not recorded.
#
# Knobs (env or $DOTFILES_HOME/agent_guard.local):
#   DOTFILES_AGENT_AUDIT=false          disable
#   DOTFILES_AGENT_AUDIT_FILE=<path>    override the file
#   DOTFILES_AGENT_AUDIT_MAX_CHARS=N    truncate long commands (default 4000)
#
# Read it with `audit_bash_history -a [N|-f]` from a normal shell.

function __dotfiles_agent_audit_enabled {
	case "${DOTFILES_AGENT_AUDIT-true}" in
		1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) return 0 ;;
		*) return 1 ;;
	esac
}

# Where agent audit records go. Keep in sync with
# __dotfiles_audit_resolve_file in functions.internal.d/10-history.bash —
# agent shells load neither the functions runtime nor features, so this file
# carries its own copy of the chain: explicit override, then the shared
# per-user store (/var/log/dotfiles/audit, dir 1733/files 0600), then the
# account-named file, then the legacy $HOME file.
# Login-session identity map (keep in sync with
# functions.internal.d/10-history.bash): lets the SSH-key identity follow an
# agent across `su -`/`sudo su -`, which scrub BASH_HISTORY_USERNAME.
function __dotfiles_agent_audit_session_id {
	local sid=''
	if [ -n "${DOTFILES_AUDIT_SESSION_ID:-}" ]; then
		sid="$DOTFILES_AUDIT_SESSION_ID"
	elif [ -r /proc/self/sessionid ]; then
		IFS= read -r sid < /proc/self/sessionid 2> /dev/null
	fi
	case "$sid" in '' | *[!0-9]* | 4294967295) return 1 ;; esac
	printf '%s\n' "$sid"
}

function __dotfiles_agent_audit_identity {
	local identity="${BASH_HISTORY_USERNAME:-}" sid dir file recovered
	local re='^[A-Za-z0-9_@][A-Za-z0-9._@-]{0,63}$'
	dir="${DOTFILES_AUDIT_SESSION_DIR:-/run/dotfiles-audit/sessions}"
	if [ -n "$identity" ] && [[ "$identity" =~ $re ]]; then
		if sid="$(__dotfiles_agent_audit_session_id)" && [ -d "$dir" ] && [ -w "$dir" ]; then
			file="$dir/$sid"
			if [ ! -r "$file" ] || [ "$(cat "$file" 2> /dev/null)" != "$identity" ]; then
				( umask 077; printf '%s\n' "$identity" > "$file" ) 2> /dev/null || true
			fi
		fi
		printf '%s\n' "$identity"
		return 0
	fi
	if sid="$(__dotfiles_agent_audit_session_id)"; then
		file="$dir/$sid"
		if [ -r "$file" ]; then
			IFS= read -r recovered < "$file" 2> /dev/null
			if [ -n "$recovered" ] && [[ "$recovered" =~ $re ]]; then
				printf '%s\n' "$recovered"
				return 0
			fi
		fi
	fi
	id -un
}

function __dotfiles_agent_audit_resolve_file {
	local override="${DOTFILES_AGENT_AUDIT_FILE:-}"
	local legacy="$HOME/.bash_history_audit_agent"
	local dir candidate account_candidate identity

	if [ -n "$override" ]; then
		printf '%s\n' "$override"
		return 0
	fi

	dir="${DOTFILES_AUDIT_DIR:-}"
	if [ -z "$dir" ] && [ "${DOTFILES_INSTALL_SCOPE:-user}" = 'system' ]; then
		dir='/var/log/dotfiles/audit'
	fi

	if [ -n "$dir" ] && [ -d "$dir" ] && [ -x "$dir" ]; then
		identity="$(__dotfiles_agent_audit_identity)"
		candidate="$dir/${identity}.agent.log"
		if [ -w "$candidate" ] || { [ ! -e "$candidate" ] && [ -w "$dir" ]; }; then
			printf '%s\n' "$candidate"
			return 0
		fi
		account_candidate="$dir/$(id -un).agent.log"
		if [ "$account_candidate" != "$candidate" ] \
			&& { [ -w "$account_candidate" ] || { [ ! -e "$account_candidate" ] && [ -w "$dir" ]; }; }; then
			printf '%s\n' "$account_candidate"
			return 0
		fi
	fi

	printf '%s\n' "$legacy"
}

function __dotfiles_agent_audit_now_us {
	local now
	if [ -n "${EPOCHREALTIME:-}" ]; then
		now="${EPOCHREALTIME/[.,]/}"
		printf '%s\n' "$now"
	else
		now="$(date +%s%N)"
		# BSD/macOS date leaves %N literal; fall back to whole seconds.
		case "$now" in *[!0-9]*) now="$(( $(date +%s) * 1000000000 ))" ;; esac
		printf '%s\n' "$((now / 1000))"
	fi
}

function __dotfiles_agent_audit_format_duration {
	# Self-contained copy of format_duration_us (functions.internal.d/
	# 40-prompt.bash) so agent and interactive audit logs stay comparable;
	# keep the two in sync. Non-numeric input renders as '-'.
	local delta_us="${1:-0}"
	local us ms s m h duration_display

	if ! [[ "$delta_us" =~ ^[0-9]+$ ]]; then
		printf '%s\n' '-'
		return
	fi

	us=$((delta_us % 1000))
	ms=$(((delta_us / 1000) % 1000))
	s=$(((delta_us / 1000000) % 60))
	m=$(((delta_us / 60000000) % 60))
	h=$((delta_us / 3600000000))

	if ((h > 0)); then
		duration_display=${h}h${m}m
	elif ((m > 0)); then
		duration_display=${m}m${s}s
	elif ((s >= 10)); then
		duration_display=${s}.$((ms / 100))s
	elif ((s > 0)); then
		duration_display=${s}.$(printf %03d "$ms")s
	elif ((ms >= 100)); then
		duration_display=${ms}ms
	elif ((ms > 0)); then
		duration_display=${ms}.$((us / 100))ms
	else
		duration_display=${us}us
	fi

	printf '%s\n' "$duration_display"
}

# __dotfiles_agent_audit_write <exit_code> <duration_us|-> <command>
function __dotfiles_agent_audit_write {
	local cmd_exit="${1:-0}" duration_us="${2:--}" command_raw="${3-}"
	local audit_file audit_dir timestamp history_user agent_name command_for_audit
	local duration_display max_chars

	[ -n "$command_raw" ] || return 0

	audit_file="${__dotfiles_agent_audit_file_resolved:-$(__dotfiles_agent_audit_resolve_file)}"
	audit_dir="${audit_file%/*}"
	[ "$audit_dir" = "$audit_file" ] && audit_dir='.'
	mkdir -p "$audit_dir" 2> /dev/null || return 0
	if [ ! -e "$audit_file" ]; then
		{ : > "$audit_file" && chmod 600 "$audit_file"; } 2> /dev/null || return 0
	fi

	max_chars="${DOTFILES_AGENT_AUDIT_MAX_CHARS:-4000}"
	[[ "$max_chars" =~ ^[0-9]+$ ]] || max_chars=4000
	if (( max_chars > 0 && ${#command_raw} > max_chars )); then
		command_raw="${command_raw:0:max_chars} ...[truncated $(( ${#command_raw} - max_chars )) chars]"
	fi

	# Keep one record per line: escape only multi-line commands (same rule as
	# the regular audit log).
	if [[ "$command_raw" == *$'\n'* ]]; then
		printf -v command_for_audit '%q' "$command_raw"
	else
		command_for_audit="$command_raw"
	fi

	timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
	history_user="$(__dotfiles_agent_audit_identity)"
	# Strip control chars (esp. newlines): BASH_HISTORY_USERNAME is
	# attacker-influenceable and must not forge audit records.
	history_user="${history_user//[![:print:]]/}"
	[ "${#history_user}" -gt 24 ] && history_user="${history_user:0:21}..."
	agent_name="${DOTFILES_AGENT:-agent}"
	[ "${#agent_name}" -gt 14 ] && agent_name="${agent_name:0:11}..."
	duration_display="$(__dotfiles_agent_audit_format_duration "$duration_us")"

	printf '%-24s  %-24s  %-14s  exit:%-3s  took:%-9s  %s\n' \
		"$timestamp" "$history_user" "$agent_name" "$cmd_exit" "$duration_display" "$command_for_audit" >> "$audit_file" 2> /dev/null
}

function __dotfiles_agent_audit_on_exit {
	local cmd_exit=$?
	local now_us
	now_us="$(__dotfiles_agent_audit_now_us)"
	__dotfiles_agent_audit_write "$cmd_exit" "$((now_us - __dotfiles_agent_audit_start_us))" "${BASH_EXECUTION_STRING-}"
}

function __dotfiles_agent_audit_prompt {
	local cmd_exit=$?
	local current_histcmd="${HISTCMD:-}" command_raw

	[ -n "$current_histcmd" ] || return 0
	[ "$current_histcmd" = "${__dotfiles_agent_audit_last_histcmd:-}" ] && return 0
	__dotfiles_agent_audit_last_histcmd="$current_histcmd"

	command_raw="$(builtin fc -ln -1 2> /dev/null | sed 's/^[[:space:]]*//')"
	[ -n "$command_raw" ] || return 0
	__dotfiles_agent_audit_write "$cmd_exit" '-' "$command_raw"
}

if ! __dotfiles_agent_audit_enabled; then
	dotfiles_dbg "Agent audit disabled via DOTFILES_AGENT_AUDIT=${DOTFILES_AGENT_AUDIT}"
elif [ -n "${BASH_EXECUTION_STRING+x}" ] && [[ $- != *i* ]]; then
	if [ "${DOTFILES_AGENT:-}" = 'claude-code' ]; then
		# Only Claude Code's snapshot-generator shell gets here; its real tool
		# calls never read rc files. Audited via init/claude-code-audit-hook.sh.
		dotfiles_dbg "Agent audit: skipping claude-code snapshot shell"
	else
		__dotfiles_agent_audit_file_resolved="$(__dotfiles_agent_audit_resolve_file)"
		__dotfiles_agent_audit_start_us="$(__dotfiles_agent_audit_now_us)"
		trap '__dotfiles_agent_audit_on_exit' EXIT
		dotfiles_dbg "Agent audit: EXIT-trap recorder armed for bash -c invocation -> ${__dotfiles_agent_audit_file_resolved}"
	fi
elif [[ $- == *i* ]]; then
	__dotfiles_agent_audit_file_resolved="$(__dotfiles_agent_audit_resolve_file)"
	__dotfiles_agent_audit_last_histcmd="${HISTCMD:-}"
	PROMPT_COMMAND="__dotfiles_agent_audit_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
	dotfiles_dbg "Agent audit: PROMPT_COMMAND recorder installed -> ${__dotfiles_agent_audit_file_resolved}"
else
	dotfiles_dbg "Agent audit: non-interactive shell without -c string; not recorded"
fi

unset -f __dotfiles_agent_audit_enabled
