#!/usr/bin/env bash
[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: Executing .DOTFILES_FEATURES]"

if ! declare -F dotfiles_dbg > /dev/null; then
	function dotfiles_dbg {
		# Always return 0: callers routinely end with a dbg line, and a
		# fall-through rc of 1 (debug off) would corrupt their exit status.
		[[ "${DOTFILES_DEBUG:-}" == "true" ]] && printf '[DOTFILE_DBG: %s]\n' "$*"
		return 0
	}
fi

# Centralized feature switches for shell behavior.
# Supported profiles:
# - minimal (default): shared functions/aliases with no prompt automation
# - light: near-vanilla prompt, metadata only when relevant
# - full: rich prompt, history/env automation, and command metadata

dotfiles_env_requested_profile="${DOTFILES_FEATURE_PROFILE-<unset>}"
DOTFILES_FEATURE_PROFILE='minimal'
dotfiles_dbg "features initial DOTFILES_FEATURE_PROFILE=${DOTFILES_FEATURE_PROFILE} (env requested=${dotfiles_env_requested_profile})"
dotfiles_dbg "features preexisting env: custom_prompt=${DOTFILES_FEATURE_CUSTOM_PROMPT-<unset>} prompt_hooks=${DOTFILES_FEATURE_PROMPT_HOOKS-<unset>} metadata_mode=${DOTFILES_FEATURE_PROMPT_METADATA_MODE-<unset>} show_exit=${DOTFILES_FEATURE_PROMPT_SHOW_EXIT_CODE-<unset>} show_on_error=${DOTFILES_FEATURE_PROMPT_SHOW_ON_ERROR-<unset>} track_method=${DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD-<unset>}"

dotfiles_local_features_file="${DOTFILES_LOCAL_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles}"/features.local

# Pass 1: let local file choose a profile.
if [ -r "$dotfiles_local_features_file" ] && [ -f "$dotfiles_local_features_file" ]; then
	dotfiles_dbg "Sourcing local overrides (profile pre-pass) from $dotfiles_local_features_file"
	source "$dotfiles_local_features_file"
	dotfiles_dbg "After local profile pre-pass: profile=${DOTFILES_FEATURE_PROFILE}"
else
	dotfiles_dbg "No local override file at $dotfiles_local_features_file"
fi

# Environment-requested profile wins over the local file (enables
# `DOTFILES_FEATURE_PROFILE=full bash -l` and per-invocation testing).
if [ "$dotfiles_env_requested_profile" != '<unset>' ]; then
	case "$dotfiles_env_requested_profile" in
		minimal | light | full)
			DOTFILES_FEATURE_PROFILE="$dotfiles_env_requested_profile"
			dotfiles_dbg "Environment-requested profile '${DOTFILES_FEATURE_PROFILE}' overrides the local file"
			;;
		*)
			dotfiles_dbg "Ignoring unknown environment-requested profile '${dotfiles_env_requested_profile}'"
			dotfiles_env_requested_profile='<unset>'
			;;
	esac
fi

# Apply a conservative baseline first. This is also the minimal profile: it
# provides functions, aliases, completion, and standard exports without prompt
# hooks, automatic environment loading, or background update checks.
DOTFILES_FEATURE_CUSTOM_PROMPT='false'
DOTFILES_FEATURE_PROMPT_HOOKS='false'
DOTFILES_FEATURE_PROMPT_METADATA='false'
DOTFILES_FEATURE_PROMPT_METADATA_MODE='never' # always|smart|never
DOTFILES_FEATURE_PROMPT_SHOW_ON_ERROR='false'
DOTFILES_FEATURE_PROMPT_SHOW_EXIT_CODE='false'
DOTFILES_FEATURE_PROMPT_SHOW_STATUS_SYMBOL='false'
DOTFILES_FEATURE_PROMPT_SHOW_DURATION='false'
DOTFILES_FEATURE_PROMPT_SHOW_DIVIDER='false'
DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US='750000'
DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US='100000'
DOTFILES_FEATURE_SET_TERMINAL_TITLE='false'
DOTFILES_FEATURE_TRACK_COMMAND_DURATION='false'
DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='auto' # auto|ps0|debug
DOTFILES_FEATURE_LOCAL_HISTORY='false'
DOTFILES_FEATURE_AUTO_DOT_ENV='false'
DOTFILES_FEATURE_HISTORY_TIMESTAMPS='false'
DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK='false'
DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE='interactive'
DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS='43200'
# Command auditing is independent of the profile ladder: it stays on in every
# profile (including minimal) and is only disabled explicitly via
# features.local or the environment.
DOTFILES_FEATURE_HISTORY_AUDIT='true'

# Apply profile-specific additions deterministically (do not inherit stale
# feature values from a previous shell generation).
case "$DOTFILES_FEATURE_PROFILE" in
	minimal)
		dotfiles_dbg "Applying profile defaults for 'minimal'"
		;;
	light)
		dotfiles_dbg "Applying profile defaults for '${DOTFILES_FEATURE_PROFILE}'"
		DOTFILES_FEATURE_PROMPT_HOOKS='true'
		DOTFILES_FEATURE_PROMPT_METADATA='true'
		DOTFILES_FEATURE_PROMPT_METADATA_MODE='smart' # always|smart|never
		DOTFILES_FEATURE_PROMPT_SHOW_DURATION='true'
		DOTFILES_FEATURE_PROMPT_SHOW_DIVIDER='true'
		DOTFILES_FEATURE_SET_TERMINAL_TITLE='true'
		DOTFILES_FEATURE_TRACK_COMMAND_DURATION='true'
		DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='debug' # auto|ps0|debug
		DOTFILES_FEATURE_LOCAL_HISTORY='true'
		DOTFILES_FEATURE_AUTO_DOT_ENV='true'
		DOTFILES_FEATURE_HISTORY_TIMESTAMPS='true'
		;;
	full)
		dotfiles_dbg "Applying profile defaults for 'full'"
		DOTFILES_FEATURE_CUSTOM_PROMPT='true'
		DOTFILES_FEATURE_PROMPT_HOOKS='true'
		DOTFILES_FEATURE_PROMPT_METADATA='true'
		DOTFILES_FEATURE_PROMPT_METADATA_MODE='always' # always|smart|never
		DOTFILES_FEATURE_PROMPT_SHOW_ON_ERROR='true'
		DOTFILES_FEATURE_PROMPT_SHOW_EXIT_CODE='true'
		DOTFILES_FEATURE_PROMPT_SHOW_STATUS_SYMBOL='true'
		DOTFILES_FEATURE_PROMPT_SHOW_DURATION='true'
		DOTFILES_FEATURE_PROMPT_SHOW_DIVIDER='true'
		DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US='100000'
		DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US='100000'
		DOTFILES_FEATURE_SET_TERMINAL_TITLE='true'
		DOTFILES_FEATURE_TRACK_COMMAND_DURATION='true'
		DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='debug' # auto|ps0|debug
		DOTFILES_FEATURE_LOCAL_HISTORY='true'
		DOTFILES_FEATURE_AUTO_DOT_ENV='true'
		DOTFILES_FEATURE_HISTORY_TIMESTAMPS='true'
		if [[ "${DOTFILES_INSTALL_SCOPE:-user}" != 'system' ]]; then
			DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK='true'
		fi
		;;
	*)
		dotfiles_dbg "Unknown DOTFILES_FEATURE_PROFILE='${DOTFILES_FEATURE_PROFILE}', falling back to 'minimal'"
		DOTFILES_FEATURE_PROFILE='minimal'
		;;
esac

# Pass 2: re-apply local overrides on top of chosen profile defaults.
if [ -r "$dotfiles_local_features_file" ] && [ -f "$dotfiles_local_features_file" ]; then
	dotfiles_dbg "Re-applying local overrides after profile defaults from $dotfiles_local_features_file"
	source "$dotfiles_local_features_file"
	# The local file may reset the profile variable; the env request already
	# decided which profile's defaults were applied, so keep it authoritative.
	if [ "$dotfiles_env_requested_profile" != '<unset>' ]; then
		DOTFILES_FEATURE_PROFILE="$dotfiles_env_requested_profile"
	fi
fi

function _normalize_dotfiles_bool_var() {
	local var_name="$1"
	local var_value="${!var_name}"

	case "$var_value" in
		1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) var_value='true' ;;
		*) var_value='false' ;;
	esac

	printf -v "$var_name" '%s' "$var_value"
	export "$var_name"
}

for bool_var in \
	DOTFILES_FEATURE_CUSTOM_PROMPT \
	DOTFILES_FEATURE_PROMPT_HOOKS \
	DOTFILES_FEATURE_PROMPT_METADATA \
	DOTFILES_FEATURE_PROMPT_SHOW_ON_ERROR \
	DOTFILES_FEATURE_PROMPT_SHOW_EXIT_CODE \
	DOTFILES_FEATURE_PROMPT_SHOW_STATUS_SYMBOL \
	DOTFILES_FEATURE_PROMPT_SHOW_DURATION \
	DOTFILES_FEATURE_PROMPT_SHOW_DIVIDER \
	DOTFILES_FEATURE_SET_TERMINAL_TITLE \
	DOTFILES_FEATURE_TRACK_COMMAND_DURATION \
	DOTFILES_FEATURE_LOCAL_HISTORY \
	DOTFILES_FEATURE_AUTO_DOT_ENV \
	DOTFILES_FEATURE_HISTORY_TIMESTAMPS \
	DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK \
	DOTFILES_FEATURE_HISTORY_AUDIT; do
	_normalize_dotfiles_bool_var "$bool_var"
done

dotfiles_dbg "Post-normalization booleans: custom_prompt=$DOTFILES_FEATURE_CUSTOM_PROMPT prompt_hooks=$DOTFILES_FEATURE_PROMPT_HOOKS metadata=$DOTFILES_FEATURE_PROMPT_METADATA show_exit=$DOTFILES_FEATURE_PROMPT_SHOW_EXIT_CODE show_duration=$DOTFILES_FEATURE_PROMPT_SHOW_DURATION divider=$DOTFILES_FEATURE_PROMPT_SHOW_DIVIDER track_duration=$DOTFILES_FEATURE_TRACK_COMMAND_DURATION"

case "$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE" in
	[Ii][Nn][Tt][Ee][Rr][Aa][Cc][Tt][Ii][Vv][Ee]) DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE='interactive' ;;
	[Ss][Ss][Hh]) DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE='ssh' ;;
	*)
		dotfiles_dbg "Invalid DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE='$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE'; falling back to interactive"
		DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE='interactive'
		;;
esac

case "$DOTFILES_FEATURE_PROMPT_METADATA_MODE" in
	[Aa][Ll][Ww][Aa][Yy][Ss]) DOTFILES_FEATURE_PROMPT_METADATA_MODE='always' ;;
	[Ss][Mm][Aa][Rr][Tt]) DOTFILES_FEATURE_PROMPT_METADATA_MODE='smart' ;;
	[Nn][Ee][Vv][Ee][Rr]) DOTFILES_FEATURE_PROMPT_METADATA_MODE='never' ;;
	*) DOTFILES_FEATURE_PROMPT_METADATA_MODE='always' ;;
esac

case "$DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD" in
	[Aa][Uu][Tt][Oo]) DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='auto' ;;
	[Pp][Ss]0) DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='ps0' ;;
	[Dd][Ee][Bb][Uu][Gg]|[Tt][Rr][Aa][Pp]) DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='debug' ;;
	*)
		dotfiles_dbg "Invalid DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='$DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD'; falling back to auto"
		DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD='auto'
		;;
esac

if ! [[ "$DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US" =~ ^[0-9]+$ ]]; then
	dotfiles_dbg "Invalid DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US='$DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US'; falling back to 100000"
	DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US=100000
fi

if ! [[ "$DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US" =~ ^[0-9]+$ ]]; then
	dotfiles_dbg "Invalid DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US='$DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US'; falling back to 100000"
	DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US=100000
fi

if ! [[ "${DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS:-}" =~ ^[0-9]+$ ]] \
	|| [ "${DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS:-0}" -le 0 ]; then
	dotfiles_dbg "Invalid DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS='$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS'; falling back to 43200"
	DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS=43200
fi

# Deliberately NOT exported: the pre-pass treats an env-provided
# DOTFILES_FEATURE_PROFILE as an authoritative per-invocation override
# (so `DOTFILES_FEATURE_PROFILE=full bash -l` works). Exporting it turned that
# one-shot into an inheritance: every child login shell (tmux pane, nested
# `bash -l`, ssh sub-shell) then kept the parent's profile and overrode the
# user's own features.local. Keeping it a plain shell variable lets same-shell
# consumers (prompt hooks, `dotfiles_profile show`) read it while children
# re-derive the profile from features.local.
export DOTFILES_FEATURE_PROMPT_METADATA_MODE
export DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US
export DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US
export DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD
export DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE
export DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS

dotfiles_dbg "Resolved feature config: profile=$DOTFILES_FEATURE_PROFILE metadata_mode=$DOTFILES_FEATURE_PROMPT_METADATA_MODE show_on_error=$DOTFILES_FEATURE_PROMPT_SHOW_ON_ERROR long_us=$DOTFILES_FEATURE_PROMPT_LONG_COMMAND_US divider_us=$DOTFILES_FEATURE_PROMPT_DIVIDER_THRESHOLD_US track_method=$DOTFILES_FEATURE_TRACK_COMMAND_DURATION_METHOD history_timestamps=$DOTFILES_FEATURE_HISTORY_TIMESTAMPS update_check=$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK update_scope=$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_SCOPE update_interval_s=$DOTFILES_FEATURE_DOTFILES_UPDATE_CHECK_INTERVAL_SECONDS"

unset bool_var
unset dotfiles_env_requested_profile
unset dotfiles_local_features_file
unset -f _normalize_dotfiles_bool_var
