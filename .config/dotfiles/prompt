#!/usr/bin/env bash
[[ "${DOTFILES_DEBUG:-}" == true ]] && echo "[DOTFILE_DBG: Executing .BASH_PROMPT]"
# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.

if [[ "${DOTFILES_FEATURE_CUSTOM_PROMPT:-false}" == "true" ]]; then
	if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
		export TERM='gnome-256color';
		[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: .BASH_PROMPT set TERM=gnome-256color]"
	elif infocmp xterm-256color >/dev/null 2>&1; then
		export TERM='xterm-256color';
		[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: .BASH_PROMPT set TERM=xterm-256color]"
	fi;
else
	[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: DOTFILES_FEATURE_CUSTOM_PROMPT=false; .BASH_PROMPT will not override TERM or PS1]"
fi

prompt_git() {
	local s='';
	local branchName='';
	local status='';
	local line;
	local repoUrl='';
	local hasStaged=0;
	local hasUnstaged=0;
	local hasUntracked=0;
	local xy='';

	# Use one git call for branch metadata plus working tree state.
	status="$(git status --porcelain=2 --branch --ignore-submodules=dirty 2>/dev/null)" || return;

	while IFS= read -r line; do
		case "$line" in
			"# branch.head "*) branchName="${line#\# branch.head }" ;;
			"1 "*|"2 "*|"u "*)
				read -r _ xy _ <<< "$line"
				[[ "${xy:0:1}" != "." ]] && hasStaged=1
				[[ "${xy:1:1}" != "." ]] && hasUnstaged=1
				;;
			"? "*) hasUntracked=1 ;;
		esac
	done <<< "$status"

	if [[ -z "$branchName" || "$branchName" == "(detached)" ]]; then
		branchName="$(git describe --all --exact-match HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo '(unknown)')"
	fi

	# Keep the Chromium safeguard for very large repos.
	repoUrl="$(git config --get remote.origin.url 2>/dev/null)";
	if grep -q 'chromium/src.git' <<< "${repoUrl}"; then
		s+='*';
	else
		(( hasStaged )) && s+='+'
		(( hasUnstaged )) && s+='!'
		(( hasUntracked )) && s+='?'
		if git rev-parse --verify refs/stash &>/dev/null; then
			s+='$'
		fi
	fi;

	[ -n "${s}" ] && s=" [${s}]";

	echo -e "${1}${branchName}${2}${s}";
}

if tput setaf 1 &> /dev/null; then
	tput sgr0; # reset colors
	bold=$(tput bold);
	reset=$(tput sgr0);
	# Solarized colors, taken from http://git.io/solarized-colors.
	black=$(tput setaf 0);
	blue=$(tput setaf 33);
	cyan=$(tput setaf 37);
	turquoise=$(tput setaf 45);
	green=$(tput setaf 64);
	# orange=$(tput setaf 166);
	orange=$(tput setaf 172);	#modified for better contrast
	purple=$(tput setaf 125);
	red=$(tput setaf 124);
	brightred=$(tput setaf 196);
	violet=$(tput setaf 61);
	white=$(tput setaf 15);
	yellow=$(tput setaf 136);
	# Background colors & text attributes
	ANSI_red_bg=$(tput setab 196);
	ANSI_green_bg=$(tput setab 34);
	ANSI_bold=$(tput bold);
	ANSI_faint=$(tput dim);
	ANSI_underline=$(tput smul);
	ANSI_blink=$(tput blink);
	ANSI_defaults=$(tput sgr0);
else
	bold='';
	reset="\e[0m";
	black="\e[1;30m";
	blue="\e[1;34m";
	turquoise='\033[38;5;45m';
	cyan="\e[1;36m";
	green="\e[1;32m";
	# orange="\e[1;33m";
	orange='\033[38;5;172m';
	purple="\e[1;35m";
	red="\e[1;31m";
	# red="\033[38;5;31m";
	brightred='\033[38;5;196m';
	violet="\e[1;35m";
	white="\e[1;37m";
	yellow="\e[1;33m";
	# Background colors & text attributes
	ANSI_red_bg='\033[48;5;196m';
	ANSI_green_bg='\033[48;5;34m';
	ANSI_bold='\033[1m';
	ANSI_faint='\033[2m';
	ANSI_underline='\033[4m';
	ANSI_blink='\033[5m';
	ANSI_defaults='\033[0m';
fi;

if [[ "${DOTFILES_FEATURE_CUSTOM_PROMPT:-false}" != "true" ]]; then
	[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: .BASH_PROMPT exiting early without PS1/PS2 override]"
	return 0
fi


# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
	userStyle="${brightred}";
	promptStyle="${brightred}"
else
	userStyle="${orange}";
	promptStyle="${white}"
fi;

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
	# hostStyle="${bold}${red}";
	hostStyle="${cyan}";
else
	hostStyle="${yellow}";
fi;

# Bash has five prompt strings that can be customized:
# PS0 is displayed after each command, before any output.
# PS1 is the primary prompt which is displayed before each command, thus it is the one most people customize.
# PS2 is the secondary prompt displayed when a command needs more input (e.g. a multi-line command).
# PS3 is not very commonly used. It is the prompt displayed for Bash's select built-in which displays interactive menus. Unlike the other prompts, it does not expand Bash escape sequences. Usually you would customize it in the script where the select is used rather than in your .bashrc.
# PS4 is also not commonly used. It is displayed when debugging bash scripts to indicate levels of indirection. The first character is repeated to indicate deeper levels.

# Set the terminal title and prompt.
PS1="\[\033]0;\W\007\]"; # working directory base name
PS1+="\[${bold}\]\n"; # newline
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${white}\] at ";
PS1+="\[${hostStyle}\]\h"; # host
PS1+="\[${white}\] in ";
PS1+="\[${green}\]\w"; # working directory full path
# Git repository details. With DOTFILES_FEATURE_PROMPT_SHOW_PROC_TIME the git
# status is computed once per prompt inside do_my_checks (PROMPT_COMMAND) and
# cached, so it can be timed and PS1 just interpolates the result; the cached
# args use the readline non-printing markers (\001/\002, i.e. \[ \]) directly so
# the interpolated value keeps correct cursor width. Otherwise PS1 runs
# prompt_git live at each render, exactly as before.
if [[ "${DOTFILES_FEATURE_PROMPT_SHOW_PROC_TIME:-false}" == "true" ]]; then
	__dotfiles_git_prompt_pre=$'\001'"${white}"$'\002'" on "$'\001'"${violet}"$'\002'
	__dotfiles_git_prompt_suf=$'\001'"${blue}"$'\002'
	PS1+="\${__dotfiles_git_prompt_cache}";
else
	PS1+="\$(prompt_git \"\[${white}\] on \[${violet}\]\" \"\[${blue}\]\")";
fi
PS1+="\n";
# PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
if [ $(id -u) -eq 0 ]; then # you are root
	PS1+="\[${promptStyle}\]# \[${reset}\]"; else	#ROOT PROMPT
	PS1+="\[${promptStyle}\]\$ \[${reset}\]"; fi 	#user prompt
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;

# A distro ~/.bashrc runs after the profile.d hook in login and interactive
# shells and sets its own PS1. Re-apply ours once, from the first prompt, so
# the custom prompt wins whenever it is enabled. With
# DOTFILES_FEATURE_CUSTOM_PROMPT=false this file returned above and the distro
# prompt stays untouched. One-shot: PS1 changed by hand later is respected.
__dotfiles_custom_ps1="$PS1";
__dotfiles_custom_ps2="$PS2";
unset __dotfiles_prompt_reapplied;
function __dotfiles_prompt_reapply {
	[[ -n "${__dotfiles_prompt_reapplied:-}" ]] && return 0
	__dotfiles_prompt_reapplied=1
	if [[ -n "${__dotfiles_custom_ps1:-}" && "${PS1:-}" != "$__dotfiles_custom_ps1" ]]; then
		PS1="$__dotfiles_custom_ps1"
		PS2="$__dotfiles_custom_ps2"
		dotfiles_dbg ".BASH_PROMPT re-applied custom PS1/PS2 over a later rc override"
	fi
	return 0
}
case ";${PROMPT_COMMAND:-};" in
	*";__dotfiles_prompt_reapply;"*) ;;
	*) PROMPT_COMMAND="__dotfiles_prompt_reapply${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac
[[ "${DOTFILES_DEBUG:-}" == "true" ]] && echo "[DOTFILE_DBG: .BASH_PROMPT applied custom PS1/PS2]"
